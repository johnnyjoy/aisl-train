# AISL revision cloned into the image at build time.
AISL_REF=main

# Local image name during development. A future release may use
# AISL_TRAIN_IMAGE=tigersmile/aisl-train:<tag>
AISL_TRAIN_IMAGE=aisl-train:local

# Host runtime storage. MODEL_HOST_PATH must be an existing model directory.
MODEL_HOST_PATH=/absolute/path/to/model
OUTPUT_HOST_PATH=./output
CACHE_HOST_PATH=./cache

# Local model execution. The trainer does not download weights.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
